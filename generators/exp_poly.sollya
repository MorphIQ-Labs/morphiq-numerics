// The polynomials of exp (docs/exp.md, sections 5, 6 and 8.2). Each
// approximates f(r) = e^r - 1 - r - r^2/2 by r^3 times a polynomial with
// binary64 coefficients (fpminimax), and the approximation error is bounded
// rigorously (supnorm):
// - stages A and B, |r| <= 0.000677: r^2 (1/2 + r*(d3 + r*(d4 + r*d5))),
//   degree 5;
// - the fallback's fast value, |r| <= 0.0027077:
//   r^2 (1/2 + r*(c3 + r*(c4 + r*(c5 + r*c6)))), degree 6.
//
// Run in the pinned image (scripts/check_certificates.sh); prints one line per
// result, which generators/exp_constants.py reads.
prec = 300;
display = hexadecimal;
f = expm1(x) - x - x^2/2;

A = 0.0027077;
I = [-A; A];
p = fpminimax(f, [|3, 4, 5, 6|], [|D, D, D, D|], I, absolute);
c3 = coeff(p, 3); c4 = coeff(p, 4); c5 = coeff(p, 5); c6 = coeff(p, 6);
err = supnorm(p, f, I, absolute, 2^-30);
print("c3", c3);
print("c4", c4);
print("c5", c5);
print("c6", c6);
print("error_bound", sup(err));

// The stages' reduced argument: |x - n ln2/512| <= (1/2 + 2^-31) ln2/512,
// below 0.000677 (docs/exp.md, section 3).
AS = 0.000677;
IS = [-AS; AS];
ps = fpminimax(f, [|3, 4, 5|], [|D, D, D|], IS, absolute);
errs = supnorm(ps, f, IS, absolute, 2^-30);
print("d3", coeff(ps, 3));
print("d4", coeff(ps, 4));
print("d5", coeff(ps, 5));
print("stage_error_bound", sup(errs));
quit;
